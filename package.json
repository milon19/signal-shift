{
  "name": "signal-shift",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "yarn workspace @signal-shift/server dev",
    "dev:web": "yarn workspace @signal-shift/web dev",
    "test": "yarn workspace @signal-shift/server test",
    "typecheck": "yarn workspaces run typecheck",
    "build": "yarn workspace @signal-shift/web build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
